{%- comment -%}
  One person from the "Expert" metaobject (Content > Metaobjects > Expert).
  Doctors and nutrition experts are shown as "Reviewed by" or "Formulated with input from", never as recommending
  or endorsing the product. Pick the wording in the entry's "Relationship" field.
  If a video is uploaded it plays (muted, looping) instead of the photo.
  Params: e (metaobject). Only call it for entries whose "Consent received" box is ticked.
{%- endcomment -%}
{%- liquid
  assign cat = e.category.value | default: 'Doctor' | handleize
  assign rel = e.relationship.value
  if rel == blank
    if cat == 'doctor' or cat == 'nutrition-expert'
      assign rel = 'Reviewed by'
    else
      assign rel = 'Trusted by'
    endif
  endif
-%}
<article class="xp" data-cat="{{ cat }}">
  <div class="xp__media">
    {%- if e.video.value != blank -%}
      {{ e.video.value | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: true, preload: 'metadata', image_size: '800x' }}
    {%- elsif e.photo.value != blank -%}
      {{ e.photo.value | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 360px, (min-width: 700px) 45vw, 92vw', alt: e.name.value }}
    {%- endif -%}
  </div>
  <div class="xp__body">
    <p class="xp__rel">{{ rel | escape }}</p>
    {%- if e.quote.value != blank -%}<blockquote class="xp__quote">&ldquo;{{ e.quote.value | strip | escape | newline_to_br }}&rdquo;</blockquote>{%- endif -%}
    <div class="xp__who">
      <p class="xp__name">{{ e.name.value | escape }}<svg class="xp__tick" viewBox="0 0 24 24" width="18" height="18" aria-label="Verified" role="img"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></p>
      {%- if e.credential.value != blank -%}<p class="xp__cred">{{ e.credential.value | escape }}</p>{%- endif -%}
    </div>
  </div>
</article>
