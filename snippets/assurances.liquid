{%- comment -%} Checkmark list beside the buy button. Values come from Theme settings > Store policies. {%- endcomment -%}
{%- capture chk -%}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4L16 6"/></svg>{%- endcapture -%}
<div class="assure">
  {%- if settings.guarantee_days > 0 -%}<div>{{ chk }}<span>{{ settings.guarantee_days }}-day money-back guarantee</span></div>{%- elsif settings.show_todo_markers -%}<div>{{ chk }}<span>Money-back guarantee {% render 'todo', label: 'terms' %}</span></div>{%- endif -%}
  {%- if settings.subscription_policy != blank -%}<div>{{ chk }}<span>{{ settings.subscription_policy }}</span></div>{%- elsif settings.show_todo_markers -%}<div>{{ chk }}<span>Subscriptions: pause, skip or cancel {% render 'todo', label: 'policy' %}</span></div>{%- endif -%}
  {%- if settings.delivery != blank -%}<div>{{ chk }}<span>{{ settings.delivery }}</span></div>{%- elsif settings.show_todo_markers -%}<div>{{ chk }}<span>Delivery {% render 'todo', label: 'areas and charges' %}</span></div>{%- endif -%}
</div>
