<footer>
  <div class="wrap">
    <div class="fcols">
      <div style="display:grid;gap:10px">
        <span class="logo" style="font-size:1.2rem;color:var(--ink)">{%- render 'logo' -%}</span>
        {%- render 'tagline', size: 'sm', style: 'font-size:.72rem' -%}
      </div>
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign title = section.settings.title_1
              assign menu = section.settings.menu_1
              assign fallback = '30-Day Box|/#shop,Subscribe & save|/#shop'
            when 2
              assign title = section.settings.title_2
              assign menu = section.settings.menu_2
              assign fallback = 'Inside the Formula|/#formula,Quality|/#quality,The science|/#science,How to use|/#ritual'
            else
              assign title = section.settings.title_3
              assign menu = section.settings.menu_3
              assign fallback = 'FAQ|/#faq,Shipping & returns|/#faq,Contact|/#faq'
          endcase
        -%}
        <div><h4>{{ title }}</h4><ul>
          {%- if menu.links.size > 0 -%}
            {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          {%- else -%}
            {%- assign items = fallback | split: ',' -%}
            {%- for item in items -%}{%- assign parts = item | split: '|' -%}<li><a href="{{ parts[1] }}">{{ parts[0] | escape }}</a></li>{%- endfor -%}
          {%- endif -%}
        </ul></div>
      {%- endfor -%}
    </div>
    <p>{{ settings.disclaimer }}</p>
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
  </div>
</footer>
{% schema %}
{ "name": "Footer", "settings": [
  { "type": "paragraph", "content": "Pick a menu for each column (Online Store > Navigation). Empty columns show links to the home page sections." },
  { "type": "text", "id": "title_1", "label": "Column 1 title", "default": "Shop" },
  { "type": "link_list", "id": "menu_1", "label": "Column 1 menu" },
  { "type": "text", "id": "title_2", "label": "Column 2 title", "default": "Learn" },
  { "type": "link_list", "id": "menu_2", "label": "Column 2 menu" },
  { "type": "text", "id": "title_3", "label": "Column 3 title", "default": "Help" },
  { "type": "link_list", "id": "menu_3", "label": "Column 3 menu", "default": "footer" }
] }
{% endschema %}
