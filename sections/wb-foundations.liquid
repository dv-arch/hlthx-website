{%- comment -%} The eight foundations grid. A card with a link is clickable; a card without one shows "Coming soon". {%- endcomment -%}
<section id="foundations">
  <div class="wrap">
    <div class="wb-head">
      {%- if section.settings.eyebrow != blank -%}<p class="wb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}{% if section.settings.accent != blank %} <em>{{ section.settings.accent }}</em>{% endif %}</h2>
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="wb-found">
      {%- for block in section.blocks -%}
        {%- assign here = false -%}
        {%- if block.settings.link != blank and request.path == block.settings.link -%}{%- assign here = true -%}{%- endif -%}
        {%- if block.settings.link != blank -%}
        <a class="wb-fcard" href="{{ block.settings.link }}"{% if here %} aria-current="page"{% endif %} {{ block.shopify_attributes }}><span class="n">{{ block.settings.number }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><span class="go">{% if here %}You are here{% else %}Explore &rarr;{% endif %}</span></a>
        {%- else -%}
        <div class="wb-fcard wb-fcard--soon" {{ block.shopify_attributes }}><span class="n">{{ block.settings.number }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><span class="go">Coming soon</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.cta != blank -%}<p style="margin-top:28px"><a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta }} &rarr;</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Eight foundations", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Whole body nutrition" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Eight foundations for" },
  { "type": "text", "id": "accent", "label": "Heading (red)", "default": "everyday health." },
  { "type": "textarea", "id": "text", "label": "Text", "default": "We start with the body's functional needs, then explore the HLTHX ingredients relevant to each foundation and the scientific research behind them." },
  { "type": "text", "id": "cta", "label": "Button (optional)" },
  { "type": "text", "id": "cta_link", "label": "Button link", "default": "/pages/whole-body-nutrition" }
], "blocks": [{ "type": "foundation", "name": "Foundation", "limit": 12, "settings": [
  { "type": "text", "id": "number", "label": "Number", "default": "01" },
  { "type": "text", "id": "title", "label": "Title", "default": "Gut & Digestive Health" },
  { "type": "textarea", "id": "text", "label": "Text" },
  { "type": "text", "id": "link", "label": "Page address", "info": "For example /pages/bones-teeth. Leave empty to show Coming soon." }
] }], "presets": [{ "name": "Eight foundations" }] }
{% endschema %}
