{%- if section.blocks.size > 0 or settings.show_todo_markers -%}
<section id="reviews">
  <div class="wrap">
    <div class="rev-head">
      <div style="display:grid;gap:20px"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div>
      <div class="rev-score">
        {%- if section.settings.rating != blank and section.settings.review_count > 0 -%}
          <b>{{ section.settings.rating }}</b> {% render 'stars' %}<div class="muted">{{ section.settings.review_count }} verified reviews</div>
        {%- else -%}{% render 'todo', label: 'average rating' %}{%- endif -%}
      </div>
    </div>
    <div class="reviews">
      {%- for block in section.blocks -%}
      <div class="review" {{ block.shopify_attributes }}>{% render 'stars' %}<p>{{ block.settings.text }}</p><div class="who">{{ block.settings.name }}</div></div>
      {%- else -%}
        {%- for i in (1..3) -%}<div class="review">{% render 'stars' %}<p>{% render 'todo', label: 'verified customer review' %}</p><div class="who">{% render 'todo', label: 'name, city' %}</div></div>{%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "Reviews", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "What people say." },
  { "type": "text", "id": "rating", "label": "Average rating (e.g. 4.8)" },
  { "type": "number", "id": "review_count", "label": "Number of verified reviews" }
], "blocks": [{ "type": "review", "name": "Review", "settings": [
  { "type": "textarea", "id": "text", "label": "Review" },
  { "type": "text", "id": "name", "label": "Name, city" }
] }], "presets": [{ "name": "Reviews" }] }
{% endschema %}
