<section id="science">
  <div class="wrap">
    <div class="split">
      <div style="display:grid;gap:20px"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div>
      <p class="muted">{{ section.settings.text }}</p>
    </div>
    <div class="experts">
      {%- for block in section.blocks -%}
      <div class="expert" {{ block.shopify_attributes }}>
        {%- if block.settings.photo -%}{{ block.settings.photo | image_url: width: 112 | image_tag: width: 56, height: 56, style: 'width:56px;height:56px;border-radius:50%;object-fit:cover', alt: block.settings.name }}{%- endif -%}
        <h3>{{ block.settings.name }}</h3><p class="muted">{{ block.settings.role }}</p>
      </div>
      {%- else -%}
        {%- for i in (1..3) -%}<div class="expert"><div class="ph"></div><h3>{% render 'todo', label: 'name' %}</h3><p class="muted">{% render 'todo', label: 'credentials and role in formulation' %}</p></div>{%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Experts", "max_blocks": 6, "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The science" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Formulated with care. Checked by experts." },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Who developed the formula, and the research behind each ingredient category." }
], "blocks": [{ "type": "expert", "name": "Expert", "settings": [
  { "type": "image_picker", "id": "photo", "label": "Photo" },
  { "type": "text", "id": "name", "label": "Name" },
  { "type": "text", "id": "role", "label": "Credentials and role" }
] }], "presets": [{ "name": "Experts" }] }
{% endschema %}
