<div class="announce">
  {%- if section.settings.text != blank -%}
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" style="text-decoration:none">{{ section.settings.text }}</a>{%- else -%}{{ section.settings.text }}{%- endif -%}
  {%- else -%}
    <a href="/pages/pre-book" style="text-decoration:none">Pre-book now for our special launch &rarr;</a>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Announcement bar", "settings": [
  { "type": "text", "id": "text", "label": "Message", "info": "Leave blank to show the pre-book launch message." },
  { "type": "url", "id": "link", "label": "Link" }
] }
{% endschema %}
