<section>
  <div class="wrap">
    <div class="wb-head">{%- if section.settings.eyebrow != blank -%}<p class="wb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2>{{ section.settings.heading }}</h2></div>
    <div class="wb-spot">
      <p class="lbl">{{ section.settings.label }}</p>
      <h3>{{ section.settings.title }}</h3>
      {%- if section.settings.source != blank -%}<p class="src">{{ section.settings.source }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}<div class="wb-nums">{%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{{ block.settings.label }}</span></div>{%- endfor -%}</div>{%- endif -%}
      {%- if section.settings.findings != blank -%}<div class="rte"><p class="lbl lbl--w">{{ section.settings.findings_heading }}</p>{{ section.settings.findings }}</div>{%- endif -%}
      {%- if section.settings.meaning != blank -%}<div class="rte means"><p class="lbl lbl--w">{{ section.settings.meaning_heading }}</p>{{ section.settings.meaning }}</div>{%- endif -%}
      {%- if section.settings.disclaimer != blank -%}<p class="disc">{{ section.settings.disclaimer }}</p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Research spotlight", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The science" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "What does science say?" },
  { "type": "text", "id": "label", "label": "Label", "default": "Research spotlight" },
  { "type": "textarea", "id": "title", "label": "Study title" },
  { "type": "text", "id": "source", "label": "Source (authors, journal, year)" },
  { "type": "text", "id": "findings_heading", "label": "Findings heading", "default": "What did researchers find?" },
  { "type": "richtext", "id": "findings", "label": "Findings" },
  { "type": "text", "id": "meaning_heading", "label": "Meaning heading", "default": "What this research means for HLTHX" },
  { "type": "richtext", "id": "meaning", "label": "What it means" },
  { "type": "textarea", "id": "disclaimer", "label": "Small print", "default": "Educational content. Not a finished-product clinical efficacy claim." }
], "blocks": [{ "type": "stat", "name": "Key number", "limit": 4, "settings": [
  { "type": "text", "id": "value", "label": "Number", "default": "593" },
  { "type": "text", "id": "label", "label": "Label", "default": "Participants" }
] }], "presets": [{ "name": "Research spotlight" }] }
{% endschema %}
