<section class="page-main"><div class="wrap" style="display:grid;gap:24px;max-width:640px">
  <div class="logo" style="font-size:2rem">HLTHX<span style="color:var(--red-text)">™</span></div>
  <h1 style="font-size:clamp(2rem,5vw,3.4rem)">Coming soon.</h1>
  <p class="lede">{{ shop.password_message | default: 'Feel Better. Every Day.' }}</p>
  {%- form 'storefront_password', class: 'field' -%}
    <label for="pw">Store password</label>
    <input id="pw" type="password" name="password" autocomplete="current-password">
    {{ form.errors | default_errors }}
    <div><button class="btn btn-red" type="submit">Enter</button></div>
  {%- endform -%}
</div></section>
{% schema %}{ "name": "Password" }{% endschema %}
