<section class="badges" aria-label="Highlights">
  <div class="wrap">
    {%- for block in section.blocks -%}
    {%- if block.settings.confirm and settings.show_todo_markers == false -%}{%- continue -%}{%- endif -%}
    <div class="badge-i" {{ block.shopify_attributes }}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {%- case block.settings.icon -%}
      {%- when 'flask' -%}<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/><path d="M7 15h10"/>
      {%- when 'shield' -%}<path d="M12 21c5-2 8-6 8-11V5l-8-2-8 2v5c0 5 3 9 8 11z"/><path d="M9 12l2 2 4-4"/>
      {%- when 'cal' -%}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
      {%- else -%}<path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>
      {%- endcase -%}
      </svg>
      <span>{{ block.settings.text }}{% if block.settings.confirm %} {% render 'todo' %}{% endif %}</span>
    </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Highlights strip", "max_blocks": 4, "settings": [], "blocks": [{ "type": "badge", "name": "Highlight", "settings": [
  { "type": "select", "id": "icon", "label": "Icon", "default": "box", "options": [
    {"value":"box","label":"Box"},{"value":"cal","label":"Calendar"},{"value":"flask","label":"Lab"},{"value":"shield","label":"Shield"} ] },
  { "type": "text", "id": "text", "label": "Text", "default": "One sachet, once a day" },
  { "type": "checkbox", "id": "confirm", "label": "Show \"To confirm\" marker", "default": false }
] }], "presets": [{ "name": "Highlights strip", "blocks": [
  { "type": "badge", "settings": { "icon": "box", "text": "30 sachets in every box" } },
  { "type": "badge", "settings": { "icon": "cal", "text": "One sachet, once a day" } },
  { "type": "badge", "settings": { "icon": "flask", "text": "Third-party tested", "confirm": true } },
  { "type": "badge", "settings": { "icon": "shield", "text": "Guarantee", "confirm": true } }
] }] }
{% endschema %}
