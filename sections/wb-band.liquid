<section class="wb-band">
  <div class="wrap">
    <div><h2>{{ section.settings.heading }}{% if section.settings.accent != blank %} <em>{{ section.settings.accent }}</em>{% endif %}</h2></div>
    <div class="side">
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.cta != blank -%}<a class="btn btn-red" href="{{ section.settings.cta_link }}">{{ section.settings.cta }} &rarr;</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Pre-book band", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Feel better." },
  { "type": "text", "id": "accent", "label": "Heading (gold)", "default": "Every day." },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Pre-book HLTHX™ and be first to get it at launch. No payment today." },
  { "type": "text", "id": "cta", "label": "Button", "default": "Pre-book now" },
  { "type": "text", "id": "cta_link", "label": "Button link", "default": "/pages/pre-book" }
], "presets": [{ "name": "Pre-book band" }] }
{% endschema %}
