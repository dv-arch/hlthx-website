<section id="ritual">
  <div class="wrap">
    <div style="display:grid;gap:20px"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div>
    <div class="steps">
      {%- for block in section.blocks -%}
      <div class="step" {{ block.shopify_attributes }}>
        <div class="pic">
          {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover;border-radius:6px' }}
          {%- else -%}
          <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {%- case forloop.index -%}
          {%- when 1 -%}<rect x="28" y="22" width="44" height="64" rx="4"/><path d="M28 34h44"/><path d="M60 14l10 10" stroke="var(--red-text)"/>
          {%- when 2 -%}<path d="M30 28h40l-5 58H35z"/><path d="M33 46h34" stroke="var(--red-text)"/><path d="M58 12l-8 44"/>
          {%- else -%}<circle cx="50" cy="50" r="30"/><path d="M38 56c4 6 20 6 24 0" stroke="var(--red-text)"/><path d="M40 42h0M60 42h0" stroke-width="5"/>
          {%- endcase -%}
          </svg>
          {%- endif -%}
        </div>
        <h3>{{ block.settings.title }}</h3>
        <p class="muted">{{ block.settings.text }}</p>
      </div>
      {%- endfor -%}
    </div>
    <div class="directions">
      <h3>Directions for use</h3>
      {%- if section.settings.directions != blank -%}{{ section.settings.directions }}{%- else -%}<p>{%- render 'todo', label: 'approved usage directions' -%}</p>{%- endif -%}
      {%- if section.settings.warnings != blank -%}<div class="muted" style="font-size:.9rem">{{ section.settings.warnings }}</div>{%- else -%}<p>{%- render 'todo', label: 'warnings and storage' -%}</p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Daily ritual", "max_blocks": 3, "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The daily ritual" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Open. Mix. Enjoy." },
  { "type": "richtext", "id": "directions", "label": "Directions for use" },
  { "type": "richtext", "id": "warnings", "label": "Warnings and storage" }
], "blocks": [{ "type": "step", "name": "Step", "settings": [
  { "type": "text", "id": "title", "label": "Title", "default": "Open" },
  { "type": "text", "id": "text", "label": "Text" },
  { "type": "image_picker", "id": "image", "label": "Image (optional)" }
] }], "presets": [{ "name": "Daily ritual", "blocks": [
  {"type":"step","settings":{"title":"Open","text":"Tear open one 15 g sachet."}},
  {"type":"step","settings":{"title":"Mix","text":"Stir it into water."}},
  {"type":"step","settings":{"title":"Enjoy","text":"Drink once a day, every day. Consistency is what counts."}}
] }] }
{% endschema %}
