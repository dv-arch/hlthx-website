{%- assign rows = section.blocks | where: 'type', 'row' -%}
<section id="difference">
  <div class="wrap">
    <div class="split">
      <div style="display:grid;gap:20px"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div>
      <p class="lede">{{ section.settings.text }}</p>
    </div>
    <div class="stats">
      {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}
      <div class="stat" {{ block.shopify_attributes }}><b>{{ block.settings.value }}{% if block.settings.unit != blank %}<small>{{ block.settings.unit }}</small>{% endif %}</b><span>{{ block.settings.label }}</span></div>
      {%- endif -%}{%- endfor -%}
    </div>
    {%- if rows.size > 0 -%}
    <div class="compare" role="table" aria-label="One sachet compared with separate products">
      <div class="crow head" role="row"><span role="columnheader">{{ section.settings.compare_label }}</span><span class="us" role="columnheader">{{ section.settings.us_label }}</span><span role="columnheader">{{ section.settings.them_label }}</span></div>
      {%- for block in rows -%}
      <div class="crow" role="row" {{ block.shopify_attributes }}><span role="cell">{{ block.settings.name }}</span><span class="yes" role="cell">✓</span><span role="cell" class="muted">+1</span></div>
      {%- endfor -%}
      <div class="crow" role="row"><span role="cell"><b>{{ section.settings.total_label }}</b></span><span class="tot" role="cell">1</span><span class="tot" role="cell">{{ rows.size }}</span></div>
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "The difference", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The difference" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Your daily nutrition. Simplified." },
  { "type": "textarea", "id": "text", "label": "Text", "default": "One sachet. One daily ritual. Science-backed ingredients." },
  { "type": "header", "content": "Comparison table" },
  { "type": "text", "id": "compare_label", "label": "First column", "default": "Covered every day" },
  { "type": "text", "id": "us_label", "label": "Our column", "default": "HLTHX™" },
  { "type": "text", "id": "them_label", "label": "Other column", "default": "Separate products" },
  { "type": "text", "id": "total_label", "label": "Total row", "default": "Things to buy, open and remember" }
], "blocks": [
  { "type": "stat", "name": "Highlight number", "limit": 3, "settings": [
    { "type": "text", "id": "value", "label": "Number", "default": "15" },
    { "type": "text", "id": "unit", "label": "Unit", "default": "g" },
    { "type": "text", "id": "label", "label": "Label", "default": "per sachet" }
  ] },
  { "type": "row", "name": "Comparison row", "settings": [
    { "type": "text", "id": "name", "label": "Category", "default": "Multivitamins" }
  ] }
], "presets": [{ "name": "The difference", "blocks": [
  { "type": "stat", "settings": { "value": "80+", "unit": "", "label": "ingredients" } },
  { "type": "stat", "settings": { "value": "10+", "unit": "", "label": "functional blends" } },
  { "type": "stat", "settings": { "value": "18", "unit": "billion", "label": "CFU probiotic complex" } }
] }] }
{% endschema %}
