<header class="top">
  <div class="wrap">
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {%- if section.settings.logo -%}{{ section.settings.logo | image_url: width: 240 | image_tag: height: 28, style: 'height:28px;width:auto', alt: shop.name }}{%- else -%}{%- render 'logo' -%}{%- endif -%}
    </a>
    <nav class="nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}<a class="hide-sm" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      {%- if section.settings.prebook_label != blank -%}<a class="nav-prebook" href="{{ section.settings.prebook_path | default: '/pages/pre-book' }}">{{ section.settings.prebook_label }}</a>{%- endif -%}
      <a class="btn btn-sm" href="{{ routes.cart_url }}">Cart <span class="cart-count">{{ cart.item_count }}</span></a>
    </nav>
  </div>
</header>
{% schema %}
{ "name": "Header", "settings": [
  { "type": "image_picker", "id": "logo", "label": "Logo image (optional)", "info": "Leave empty to use the HLTHX wordmark in the brand font." },
  { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
  { "type": "header", "content": "Pre-book link" },
  { "type": "text", "id": "prebook_label", "label": "Label", "default": "Pre-book", "info": "Always shown, also on phones. Leave empty to hide." },
  { "type": "text", "id": "prebook_path", "label": "Page address", "default": "/pages/pre-book" }
] }
{% endschema %}
