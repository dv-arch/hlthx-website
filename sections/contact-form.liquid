{%- comment -%}
  Contact us page. Uses Shopify's contact form: every message is emailed to the store's contact email
  (Settings > General > Store contact email), with name, email, phone, topic and message in the email.
{%- endcomment -%}
<section class="ct-hero">
  <div class="wrap ct-grid">
    <div class="ct-copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
      {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
      <ul class="ct-points">
        {%- if section.settings.email != blank -%}<li><b>Email</b> <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>{%- endif -%}
        {%- if section.settings.phone != blank -%}<li><b>Phone</b> <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></li>{%- endif -%}
        {%- if section.settings.hours != blank -%}<li><b>Hours</b> {{ section.settings.hours }}</li>{%- endif -%}
      </ul>
    </div>

    <div class="pb-card ct-card" id="contact">
      {%- form 'contact', id: 'contact-form', class: 'pb-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="pb-thanks" tabindex="-1" data-ct-thanks>
            <p class="eyebrow">Message sent</p>
            <h2>{{ section.settings.thanks_heading }}</h2>
            <p>{{ section.settings.thanks_text }}</p>
            <a class="btn btn-sm" href="{{ routes.root_url }}">Back to home</a>
          </div>
        {%- else -%}
          <h2>{{ section.settings.form_heading }}</h2>
          {%- if form.errors -%}<p class="pb-status" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}

          <div class="pb-row">
            <div class="pb-field">
              <label for="ct-name">Name</label>
              <input id="ct-name" name="contact[name]" autocomplete="name" required maxlength="80">
            </div>
            <div class="pb-field">
              <label for="ct-phone">Phone <span class="muted" style="text-transform:none;font-weight:400">(optional)</span></label>
              <input id="ct-phone" name="contact[phone]" type="tel" inputmode="tel" autocomplete="tel" maxlength="20">
            </div>
          </div>
          <div class="pb-field">
            <label for="ct-email">Email address</label>
            <input id="ct-email" name="contact[email]" type="email" inputmode="email" autocomplete="email" required maxlength="254" placeholder="you@example.com">
          </div>
          <div class="pb-field">
            <label for="ct-topic">Topic</label>
            <select id="ct-topic" name="contact[topic]" class="ct-select">
              <option>General question</option>
              <option>Pre-booking</option>
              <option>Product and ingredients</option>
              <option>Order or delivery</option>
              <option>Wholesale or partnership</option>
            </select>
          </div>
          <div class="pb-field">
            <label for="ct-body">Message</label>
            <textarea id="ct-body" name="contact[body]" rows="5" required maxlength="3000"></textarea>
          </div>
          <button class="btn btn-red pb-submit" type="submit">{{ section.settings.button }}</button>
          <p class="pb-fine">We usually reply within {{ section.settings.reply_time }}.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>
<script>
(function(){ var t = document.querySelector('[data-ct-thanks]'); if (t) t.focus(); })();
</script>

{% stylesheet %}
.ct-hero{padding-block:clamp(36px,6vw,88px)}
.ct-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,72px);align-items:start}
@media (max-width:900px){.ct-grid{grid-template-columns:1fr}}
.ct-copy{display:grid;gap:24px;min-width:0}
.ct-copy h1{font-size:clamp(2rem,5vw,4rem)}
.ct-points{list-style:none;margin:0;padding:20px 0 0;display:grid;gap:10px;border-top:1.5px solid var(--ink)}
.ct-points b{display:inline-block;min-width:5.5em;font-family:var(--mono);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;font-weight:500;color:var(--muted)}
.ct-points a{text-decoration:none}
.ct-points:empty{display:none}
.ct-card textarea,.ct-select{font:inherit;font-size:1rem;width:100%;min-width:0;padding:.75em .9em;border:1.5px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink)}
.ct-card textarea{resize:vertical}
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "paragraph", "content": "Messages are emailed to the store contact email set in Settings > General." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here to help" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Questions about HLTHX™, your pre-booking or an order? Send us a message and our team will get back to you." },
    { "type": "text", "id": "email", "label": "Email to show (optional)" },
    { "type": "text", "id": "phone", "label": "Phone to show (optional)" },
    { "type": "text", "id": "hours", "label": "Hours (optional)", "info": "For example: Mon to Sat, 10 am to 6 pm IST" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "reply_time", "label": "Reply time", "default": "1 to 2 working days" },
    { "type": "text", "id": "thanks_heading", "label": "Thank-you heading", "default": "Thanks for getting in touch" },
    { "type": "textarea", "id": "thanks_text", "label": "Thank-you text", "default": "We've received your message and will reply by email soon." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
